{
    "name": "vaersaagod/consentmate",
    "description": "No means no, mate!",
    "type": "craft-plugin",
    "version": "1.0.3",
    "license": "proprietary",
    "require": {
        "php": "^8.2.0",
        "craftcms/cms": "^5.6.0"
    },
    "require-dev": {
        "craftcms/ecs": "dev-main",
        "craftcms/phpstan": "dev-main"
    },
    "autoload": {
        "psr-4": {
            "vaersaagod\\consentmate\\": "src/"
        }
    },
    "support": {
        "docs": "https://github.com/vaersaagod/consentmate/blob/main/README.md",
        "issues": "https://github.com/vaersaagod/consentmate/issues"
    },
    "extra": {
        "handle": "consentmate",
        "name": "ConsentMate",
        "developer": "Værsågod",
        "documentationUrl": "https://github.com/vaersaagod/consentmate/blob/main/README.md",
        "changelogUrl": "https://raw.githubusercontent.com/vaersaagod/consentmate/main/CHANGELOG.md",
        "class": "vaersaagod\\consentmate\\ConsentMate"
    },
    "scripts": {
        "check-cs": "ecs check --ansi",
        "fix-cs": "ecs check --ansi --fix",
        "phpstan": "phpstan --memory-limit=1G"
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.2"
        },
        "allow-plugins": {
            "yiisoft/yii2-composer": true,
            "craftcms/plugin-installer": true
        }
    }
}
